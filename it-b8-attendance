*{box-sizing:border-box}  
body{margin:0;font-family:Arial,sans-serif;background:#f1f5f9;color:#172033}  
header{background:#12345a;color:white;text-align:center;padding:20px 10px}  
main{max-width:1100px;margin:auto;padding:15px}  
.card{background:white;padding:16px;border-radius:12px;margin-bottom:15px;box-shadow:0 2px 8px #0001}  
input,select,button{width:100%;padding:11px;margin:5px 0;border:1px solid #cbd5e1;border-radius:7px;font-size:15px}  
button{background:#12345a;color:white;border:0;font-weight:bold;cursor:pointer}  
button:hover{opacity:.9}  
.green{background:#16803c}  
.red{background:#b42318}  
.orange{background:#c27808}  
.hidden{display:none!important}  
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}  
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}  
.stat{background:#eaf1f8;padding:12px 4px;text-align:center;border-radius:8px}  
.stat strong{display:block;font-size:24px;margin-top:6px}  
.table-wrap{overflow-x:auto}  
table{border-collapse:collapse;width:100%;min-width:650px}  
th,td{padding:10px;border-bottom:1px solid #ddd;text-align:left}  
th{background:#12345a;color:white}  
.small{font-size:13px;color:#64748b;white-space:pre-wrap}  
.center{text-align:center}  
.login-box{max-width:380px;margin:35px auto;text-align:center}  
hr{border:0;border-top:1px solid #ddd;margin:18px 0}  
@media(max-width:500px){.stats{grid-template-columns:repeat(2,1fr)}}  
@media print{button,.no-print{display:none!important}body{background:white}.card{box-shadow:none}}  
