[3519,"Gobey Abdullahi Mohamed"],  
[3573,"Nacimo Cumar Xade"]  
];  
  
// MACALLIMIINTA IYO MAALINTA SHAQADOODA  
const teachers = {  
 "3565":{name:"Cabdi Qani Jama",day:"Sabti"},  
 "3566":{name:"Farah Cabdi Cusmaan",day:"Axad"},  
 "3567":{name:"ABDIFATAH AHMED",day:"Isniin"},  
 "3568":{name:"Ibraahim",day:"Talaado"},  
 "3569":{name:"Mohamud Mohamed Hassan",day:"Arbaco"}  
};  
  
// MAADOOYINKA  
const schedule = {  
 Sabti:["Basic Networking","Basic Networking"],  
 Axad:["Introduction to Web Design HTML","Introduction to Web Design HTML"],  
 Isniin:["Discrete Math I","Introduction to Physics"],  
 Talaado:["C++","C++"],  
 Arbaco:["Accounting Principles",""],  
 Khamiis:["",""],  
 Jimco:["",""]  
};  
  
const statuses=["Jooga","Maqan","Soo daahay","Fasax"];  
const $=id=>document.getElementById(id);  
  
const ROSTER_KEY="ITB8_STUDENTS_V3";  
const RECORD_KEY="ITB8_ATTENDANCE_V3";  
const PASS_KEY="ITB8_PASSWORDS_V3";  
  
function readJSON(key,fallback){  
 try{  
  const value=JSON.parse(localStorage.getItem(key));  
  return value ?? fallback;  
 }catch(e){  
  return fallback;  
 }  
}  
  
let students=readJSON(ROSTER_KEY,null);  
if(!Array.isArray(students)) students=defaultStudents.map(s=>[...s]);  
  
let records=readJSON(RECORD_KEY,{});  
let passwords=readJSON(PASS_KEY,{});  
let loggedStudent=null;  
let loggedTeacher=null;  
let isAdmin=false;  
  
const saveRoster=()=>localStorage.setItem(ROSTER_KEY,JSON.stringify(students));  
const saveRecords=()=>localStorage.setItem(RECORD_KEY,JSON.stringify(records));  
const savePasswords=()=>localStorage.setItem(PASS_KEY,JSON.stringify(passwords));  
  
function studentByID(id){  
 return students.find(s=>String(s[0])===String(id));  
}  
  
function today(){  
 const d=new Date();  
 return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");  
}  
  
$("date").value=today();  
  
function currentDate(){  
 return $("date").value||today();  
}  
  
function dayName(date){  
 return ["Axad","Isniin","Talaado","Arbaco","Khamiis","Jimco","Sabti"]  
 [new Date(date+"T12:00:00").getDay()];  
}  
  
function showPage(page){  
 ["loginPage","studentPage","teacherPage"].forEach(id=>{  
  $(id).classList.toggle("hidden",id!==page);  
 });  
}  
  
function defaultPassword(id){  
 return passwords[String(id)]||"1234";  
}  
  
// LOGIN  
function login(id,password){  
 id=String(id).trim();  
 password=String(password);  
 $("loginMessage").textContent="";  
  
 // ADMIN  
 if(id.toUpperCase()==="ADMIN" && password==="0528"){  
  loggedStudent=null;  
  loggedTeacher=null;  
  isAdmin=true;  
  $("dashboardTitle").textContent="ADMIN — Maamulka Guud";  
  $("dashboardSubtitle").textContent="Maamulka ardayda, xaadirinta iyo warbixinnada.";  
  $("teacherManagement").classList.remove("hidden");  
  renderTeacherList();  
  showPage("teacherPage");  
  loadDay();  
  return;  
 }  
  
 // MACALLIN  
 const teacher=teachers[id];  
 if(teacher){  
  if(password!=="1234"){  
   $("loginMessage").textContent="Password-ka macallinka waa khalad.";  
   return;  
  }  
  loggedStudent=null;  
  loggedTeacher={...teacher,id};  
  isAdmin=false;  
  $("dashboardTitle").textContent="Ku soo dhawoow, "+teacher.name;  
  $("dashboardSubtitle").textContent="Macallin ID: "+id+" • Maalinta shaqada: "+teacher.day;  
  $("teacherManagement").classList.add("hidden");  
  showPage("teacherPage");  
  loadDay();  
  return;  
 }  
  
 // ARDAY  
 const student=studentByID(id);  
 if(!student){  
  $("loginMessage").textContent="ID-gaas lama helin.";  
  return;  
 }  
 if(password!==defaultPassword(student[0])){  
  $("loginMessage").textContent="Password-ku waa khalad.";  
  return;  
 }  
  
 loggedStudent=student;  
 loggedTeacher=null;  
 isAdmin=false;  
 $("studentName").textContent=student[1];  
 $("studentIDLabel").textContent=student[0];  
 $("passwordMessage").textContent="";  
 showPage("studentPage");  
 renderStudentHistory();  
}  
  
$("loginForm").addEventListener("submit",e=>{  
 e.preventDefault();  
 login($("loginID").value,$("loginPassword").value);  
});  
  
$("logoutStudent").onclick=logout;  
$("logoutTeacher").onclick=logout;  
  
function logout(){  
 loggedStudent=null;  
 loggedTeacher=null;  
 isAdmin=false;  
 $("loginPassword").value="";  
 $("loginID").value="";  
 showPage("loginPage");  
}  
  
// MAADO IYO MAALIN  
function updateSubjects(){  
 const subjects=schedule[$("day").value]||["",""];  
 $("subject1").value=subjects[0];  
 $("subject2").value=subjects[1];  
}  
  
// TIRAKOOB  
function updateCounts(){  
 const data=records[currentDate()]||{};  
 $("present").textContent=students.filter(s=>data[s[0]]==="Jooga").length;  
 $("absent").textContent=students.filter(s=>data[s[0]]==="Maqan").length;  
 $("late").textContent=students.filter(s=>data[s[0]]==="Soo daahay").length;  
 $("leave").textContent=students.filter(s=>data[s[0]]==="Fasax").length;  
}  
  
// LIISKA ARDAYDA  
function renderStudents(){  
 const tbody=$("students");  
 tbody.replaceChildren();  
  
 const data=records[currentDate()]||{};  
 const query=$("search").value.trim().toLowerCase();  
  
 students.forEach(([id,name],index)=>{  
  if(query&&!String(id).includes(query)&&!name.toLowerCase().includes(query))return;  
  
  const tr=document.createElement("tr");  
  
  [index+1,id,name].forEach(v=>{  
   const td=document.createElement("td");  
   td.textContent=v;  
   tr.appendChild(td);  
  });  
  
  const statusCell=document.createElement("td");  
  const select=document.createElement("select");  
  
  const blank=document.createElement("option");  
  blank.value="";  
  blank.textContent="-- Dooro --";  
  select.appendChild(blank);  
  
  statuses.forEach(status=>{  
   const o=document.createElement("option");  
   o.value=status;  
   o.textContent=status;  
   select.appendChild(o);  
  });  
  
  select.value=data[id]||"";  
  
  select.addEventListener("change",()=>{  
   if(!records[currentDate()])records[currentDate()]={};  
  
   if(select.value)records[currentDate()][id]=select.value;  
   else delete records[currentDate()][id];  
  
   try{  
    saveRecords();  
    $("message").textContent="Xaadirinta waa la kaydiyey.";  
   }catch(e){  
    $("message").textContent="Kaydintu way fashilantay.";  
   }  
  
   updateCounts();  
  });  
  
  statusCell.appendChild(select);  
  tr.appendChild(statusCell);  
  tbody.appendChild(tr);  
 });  
  
 updateCounts();  
}  
  
// LIISKA MACALLIMIINTA  
function renderTeacherList(){  
 const tbody=$("teacherList");  
 tbody.replaceChildren();  
  
 Object.entries(teachers).forEach(([id,t])=>{  
  const tr=document.createElement("tr");  
  
  [id,t.name,t.day].forEach(v=>{  
   const td=document.createElement("td");  
   td.textContent=v;  
   tr.appendChild(td);  
  });  
  
  tbody.appendChild(tr);  
 });  
}  
  
// SOO BANDHIG MAALINTA  
function loadDay(){  
 const date=currentDate();  
  
 if(loggedTeacher&&!isAdmin){  
  $("day").value=loggedTeacher.day;  
  $("day").disabled=true;  
  $("dashboardTitle").textContent="Ku soo dhawoow, "+loggedTeacher.name;  
  $("dashboardSubtitle").textContent=  
   "Macallin ID: "+loggedTeacher.id+" • Maalinta shaqada: "+loggedTeacher.day;  
 }else{  
  $("day").disabled=false;  
  $("day").value=dayName(date);  
 }  
  
 updateSubjects();  
 renderStudents();  
  
 $("message").textContent=  
  "Taariikhda: "+date+" | Maalinta: "+$("day").value;  
}  
  
$("date").addEventListener("change",loadDay);  
  
$("day").addEventListener("change",()=>{  
 if(!loggedTeacher||isAdmin)updateSubjects();  
});  
  
$("search").addEventListener("input",renderStudents);  
  
// KU DAR ARDAY  
$("addStudent").onclick=()=>{  
 const id=$("newID").value.trim();  
 const name=$("newName").value.trim();  
  
 if(!id||!name){  
  $("addMessage").textContent="Geli ID-ga iyo magaca.";  
  return;  
 }  
  
 if(studentByID(id)||teachers[id]||id.toUpperCase()==="ADMIN"){  
  $("addMessage").textContent="ID-gaas horay ayuu u jiraa ama waa ID gaar ah.";  
  return;  
 }  
  
 students.push([id,name]);  
 students.sort((a,b)=>String(a[0]).localeCompare(String(b[0]),undefined,{numeric:true}));  
  
 try{  
  saveRoster();  
  $("addMessage").textContent="Ardayga waa lagu daray. Password-ka bilowga ah waa 1234.";  
  $("newID").value="";  
  $("newName").value="";  
  renderStudents();  
 }catch(e){  
  $("addMessage").textContent="Kaydintu way fashilantay.";  
 }  
};  
  
// KA SAAR ARDAY  
$("removeStudent").onclick=()=>{  
 const id=$("removeID").value.trim();  
 const student=studentByID(id);  
  
 if(!student){  
  $("removeMessage").textContent="ID-ga lama helin.";  
  return;  
 }  
  
 if(!confirm("Ma ka saaraysaa "+student[1]+" liiska? Taariikhdiisa waa la ilaalinayaa."))return;  
  
 students=students.filter(s=>String(s[0])!==id);  
  
 try{  
  saveRoster();  
  $("removeMessage").textContent="Ardayga waa laga saaray liiska.";  
  $("removeID").value="";  
  renderStudents();  
 }catch(e){  
  $("removeMessage").textContent="Kaydintu way fashilantay.";  
 }  
};  
  
// XAADIRIN ID  
$("markByID").onclick=()=>{  
 const id=$("markID").value.trim();  
 const status=$("markStatus").value;  
 const student=studentByID(id);  
  
 if(!student){  
  $("markMessage").textContent="ID-ga lama helin.";  
  return;  
 }  
 if(!status){  
  $("markMessage").textContent="Dooro xaaladda.";  
  return;  
 }  
  
 if(!records[currentDate()])records[currentDate()]={};  
 records[currentDate()][id]=status;  
  
 try{  
  saveRecords();  
  $("markMessage").textContent=  
   student[1]+" — "+status+" — "+currentDate();  
  renderStudents();  
 }catch(e){  
  $("markMessage").textContent="Kaydintu way fashilantay.";  
 }  
};  
  
// KAYDI  
$("save").onclick=()=>{  
 try{  
  saveRecords();  
  saveRoster();  
  $("message").textContent="Xaadirinta waa la kaydiyey.";  
 }catch(e){  
  $("message").textContent="Kaydintu way fashilantay.";  
 }  
};  
  
// DHAMMAAN JOOGA  
$("allPresent").onclick=()=>{  
 if(!confirm("Dhammaan ardayda ma Jooga ayaad ka dhigaysaa?"))return;  
  
 records[currentDate()]={};  
 students.forEach(([id])=>records[currentDate()][id]="Jooga");  
 saveRecords();  
 renderStudents();  
};  
  
// NADIIFI XAADIRINTA MAALINTA  
$("clear").onclick=()=>{  
 if(!confirm("Ma tirtiraysaa xaadirinta taariikhdan?"))return;  
 delete records[currentDate()];  
 saveRecords();  
 renderStudents();  
};  
  
$("printButton").onclick=()=>window.print();  
  
// SOO SAAR CSV  
$("export").onclick=()=>{  
 const data=records[currentDate()]||{};  
  
 const rows=[  
  ["Taariikh",currentDate()],  
  ["Maalin",$("day").value],  
  ["Maado 1",$("subject1").value],  
  ["Maado 2",$("subject2").value],  
  [],  
  ["No","ID","Magaca","Xaaladda"]  
 ];  
  
 students.forEach(([id,name],i)=>{  
  rows.push([i+1,id,name,data[id]||"Lama calaamadin"]);  
 });  
  
 const csv="\uFEFF"+rows.map(row=>  
  row.map(v=>'"'+String(v??"").replace(/"/g,'""')+'"').join(",")  
